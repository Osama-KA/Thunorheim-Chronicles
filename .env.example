# Model providers (see models.toml). Any subset works; roles skip providers without a key.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# dev (default) or public. public drops providers whose terms forbid production use.
THUNORHEIM_PROFILE=dev

# Record or replay model traffic (tests, demos without keys). Set one, not both.
# THUNORHEIM_RECORD=tests/fixtures/replay/smoke.jsonl
# THUNORHEIM_REPLAY=tests/fixtures/replay/smoke.jsonl
